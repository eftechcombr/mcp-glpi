# GLPI High-Level API (v3.0 preferred, v2.x compatible) - OAuth2 configuration
# Copy to .env and fill in your values

# Required: GLPI instance URL (no trailing slash)
GLPI_URL=https://glpi.example.com

# Optional: High-Level API version (default: 3.0)
# Use 3.0 (or 3) for GLPI 12+, or 2.3 (or 2) for GLPI 11 / v2 compatibility
# GLPI_API_VERSION=3.0

# Auth method: password | client_credentials | bearer (default: password)
GLPI_AUTH_METHOD=client_credentials

# ── Password grant (GLPI_AUTH_METHOD=password) ──
# Requires a GLPI OAuth2 client with "Password grant" enabled
# (Setup → OAuth2 Client → edit client → check "Password grant")
GLPI_USERNAME=your_username
GLPI_PASSWORD=your_password
GLPI_CLIENT_ID=your_client_id
# GLPI_CLIENT_SECRET=

# ── Client credentials grant (GLPI_AUTH_METHOD=client_credentials) ──
# Requires a GLPI OAuth2 client with "Client credentials grant" enabled
# GLPI_CLIENT_ID=your_client_id
# GLPI_CLIENT_SECRET=

# ── Bearer token (GLPI_AUTH_METHOD=bearer) ──
# Use a pre-obtained access token directly (skips OAuth2 flow)
# GLPI_ACCESS_TOKEN=your_token

# Optional: Request timeout in milliseconds (default: 15000)
GLPI_TIMEOUT_MS=15000

# Optional: Max retry attempts on 5xx/429 (default: 2)
GLPI_MAX_RETRIES=2

# Optional: Entity/Profile context headers
GLPI_ENTITY_ID=
GLPI_PROFILE_ID=
GLPI_ENTITY_RECURSIVE=false

# Optional: Enable debug logging to stderr
GLPI_DEBUG=false

# ── Hosted deployment (Streamable HTTP / multi-tenant) ──
# Serve the MCP server over HTTP instead of stdio. Leave GLPI_URL blank to
# enable multi-tenant mode: each client configures its own GLPI connection
# per session via the glpi_configure_connection tool.
# MCP_TRANSPORT=http

# REQUIRED for a reachable (non-loopback) HTTP endpoint: clients must send
# "Authorization: Bearer <token>". The server refuses to bind 0.0.0.0 without it.
# Generate one with: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Optional: allow a non-loopback bind without a token (NOT recommended)
# MCP_ALLOW_UNAUTHENTICATED=false

# Optional: cap concurrent MCP sessions (default 100)
# MCP_MAX_SESSIONS=100

# Optional: HTTP server binding (defaults: host 127.0.0.1, port 3000, path /mcp)
# Use HOST=0.0.0.0 inside containers.
# HOST=127.0.0.1
# PORT=3000
# MCP_PATH=/mcp

# Optional: Session idle TTL in ms before a session's GLPI client is evicted
# (default: 86400000 = 24h)
# SESSION_TTL_MS=86400000
